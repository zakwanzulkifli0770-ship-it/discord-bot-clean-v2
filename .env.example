# Server-side OpenAI key. Never expose this in browser code.
OPENAI_API_KEY=sk-your-key-here

# Optional model tuning. See README.md for where to adjust prompts and image settings.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-5.6-luna
PORT=3000

# Existing Discord bot settings
TOKEN=
OWNER_ID=
ADMIN_IDS=
MOD_IDS=
DASHBOARD_CHANNEL_ID=
AI_COOLDOWN_MS=15000
AI_MAX_PROMPT_LENGTH=1500
